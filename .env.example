# Copy to .env. Generate distinct random secrets; do not commit .env.
POSTGRES_PASSWORD=
LOCAL_ADMIN_TOKEN=
# Required only for online SEC access: application name + your real contact email.
SEC_USER_AGENT=
DATA_MODE=sec_live
# A-share tables have their own mode binding, independent of SEC DATA_MODE.
CN_DATA_MODE=cn_live
CN_TIMEOUT_SECONDS=20
CN_MAX_BYTES=10000000
# Text-based CNINFO PDF processing; scanned/encrypted PDFs are not OCR'd.
CN_PDF_MAX_BYTES=20000000
CN_PDF_MAX_PAGES=600
CN_PDF_TIMEOUT_SECONDS=30
CN_PDF_PARSE_TIMEOUT_SECONDS=90
CN_PDF_MAX_CHARS=2000000
CN_PDF_MAX_CHUNKS=4000
TASK_MODE=rq
DEVELOPMENT=false
DATABASE_URL=postgresql+psycopg://finsight@localhost:5432/finsight
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
SEC_TIMEOUT_SECONDS=30
SEC_MAX_BYTES=30000000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
SNAPSHOT_DIRECTORY=
# AI-only: generate once with cryptography.fernet.Fernet.generate_key().
# Keep this key stable and back it up with encrypted config backups. Never commit it.
# Missing/invalid encryption disables cloud-key writes, not financial browsing.
MASTER_ENCRYPTION_KEY=
# Operator-controlled Ollama origin only; never accepted from a browser request.
# Bare-metal backend example: http://127.0.0.1:11434
# Docker Desktop example: http://host.docker.internal:11434 (see README).
OLLAMA_BASE_URL=
LLM_MODEL_CACHE_SECONDS=120
# Per-filing HTML/exhibit safety limits. Optional embeddings are not required.
DOCUMENT_MAX_BYTES=15000000
DOCUMENT_MAX_CHUNKS=4000

